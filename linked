import java.util.*;

public class Linked {
    public static void main(String[] args) {
        LinkedList<Object> al = new LinkedList<>();
        
        al.add("Ayan");
        al.add("Roy");
        al.add("S");
        al.add(25);
        
        System.out.println("Size of al after additions: " + al.size());
        
        Iterator<Object> itr = al.iterator();
        while (itr.hasNext()) {
            System.out.println(itr.next());
        }

        al.remove("Roy");  // Remove by value
        al.remove(2);      // Remove by index (after removal above, new index)

        Iterator<Object> itr2 = al.iterator();
        while (itr2.hasNext()) {
            System.out.println(itr2.next());
        }
    }
}
